{\lang1035\par}\pard\plain \s1\ql\widctlpar\sb240\sa120\keepn\ltrpar\cf24\rtlch\af13\afs32\ltrch\hich\af6\afs32\dbch\af10\loch\f6\fs32\pagebb\sb0\sa88{\cf18\rtlch\af9\afs44\alang1035\ab\ltrch\hich\af4\afs44\alang1035\ab\dbch\af9\langfe2052\loch\f4\fs44\lang1035\b
