{\f3\lang1035\par}\pard\plain \s36\sl276\slmult1\ql\widctlpar\sb0\sa140\ltrpar\sl-290\slmult0\sb0\sa130{\rtlch\alang1035\ltrch\hich\af3\alang1035\dbch\langfe2052\loch\f3\lang1035
